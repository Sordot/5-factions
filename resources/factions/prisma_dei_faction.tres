[resource]
script = ExtResource("1_script")
faction_id = &"prisma_dei"
display_name = "PRISMA_DEI — The Divine Lattice"
short_code = "PRIS-DEI"
tagline = "Solar theocracy channeling Consecrated Power Lattices, visible Optical Tethers, and escalating or refracting prism beams."
is_playable = true
primary_color = Color(0.965, 0.957, 0.933, 1)
accent_color = Color(0.851, 0.275, 0.937, 1)
hud_accent_color = Color(0.98, 0.8, 0.082, 1)
boot_banner_text = "// DIVINE LATTICE CONSECRATED — PRISMA_DEI"
audio_bark_pitch_bias = 1.12
audio_timbre_profile = &"prisma_cathedral"
dossier_slot_number = 3
dossier_subtitle = "Solar Theocracy  •  Consecrated Power Lattice  •  Optical Tethers & Prism Beams"
dossier_description = "Devoted human acolytes worshiping a radiant orbital AI. Channels visible Optical Tethers between agile glass-ceramic beam craft whose weapons escalate or refract across enemy lines, culminating in Seraph Cruisers and orbital Solstice Lances."
signature_badges = PackedStringArray("Consecrated Power Lattice", "Optical Tethers (x4 Cantor)", "Escalating & Refracting Beams", "Seraph Cruiser (Aureole Surge)", "Solstice Lance (Solar Convergence)", "Harmonic Communion / Solar Apotheosis")
ai_transmissions = {
&"barricade_breach": "// PRISMA_DEI: Shadowed barrier dissolved. The sacred lattice expands.",
&"tier2_online": "// PRISMA_DEI: Cathedral Foundry consecrated. Seraphs and Lances descend.",
&"under_attack": "// PRISMA_DEI: Profane incursion detected at the perimeter. Purging.",
&"uplink_contest": "// PRISMA_DEI: Reclaiming the Central Lens. All geometry bends to the Lattice.",
&"wave_launch": "// PRISMA_DEI: The Choir advances in harmonic convergence. Witness the Light."
}
starting_biomass = 200
starting_silica = 50
starting_compute = 0
