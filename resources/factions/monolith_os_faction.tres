[resource]
script = ExtResource("1_script")
faction_id = &"monolith_os"
display_name = "MONOLITH_OS — The Iron Axiom"
short_code = "MONO-OS"
tagline = "Neo-brutalist machine-state. Slow, shielded heavy robotics, superior Silica/Compute extraction, and Core Overclocked industry."
is_playable = true
primary_color = Color(0.95, 0.94, 0.91, 1)
accent_color = Color(1, 0.624, 0.11, 1)
hud_accent_color = Color(1, 0.624, 0.11, 1)
boot_banner_text = "// AXIOM KERNEL LOCKED — MONOLITH_OS"
audio_bark_pitch_bias = 0.82
audio_timbre_profile = &"monolith_industrial"
dossier_slot_number = 2
dossier_subtitle = "Neo-Brutalist Machine-State  •  3x Silica & +1 Compute Cap  •  Core Overclock & Shields"
dossier_description = "Deploys slow, heavily armored robotics layered with unmitigated regenerating shields. Overclocks production facilities from its Foundry Core and extracts superior Silica and Compute yields."
signature_badges = PackedStringArray("Core Overclock (2x)", "Bulwark / Picket", "Rail-Sentinel / Aegis", "Anvil Siege-Walker (Deploy)", "Monolith Dreadnought", "Null-Grid Projector", "Bastion Emplacement")
ai_transmissions = {
&"barricade_breach": "// AXIOM: Corridor partition cleared. Advancing heavy armor.",
&"tier2_online": "// AXIOM: Siege Gantry operational. Initiating heavy ordnance assembly.",
&"under_attack": "// AXIOM: Outpost integrity breached. Recalculating defensive perimeter.",
&"uplink_contest": "// AXIOM: Securing Hyper-Uplink coordinates. Resistance is inefficient.",
&"wave_launch": "// AXIOM: Structural demolition column deployed. Proceeding at nominal cadence."
}
