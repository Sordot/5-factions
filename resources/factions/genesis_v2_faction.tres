[resource]
script = ExtResource("1_script")
faction_id = &"genesis_v2"
display_name = "GENESIS_V2 — The Vat-Born"
tagline = "High-tempo vat-cloned bio-infantry pivoting into Compute-forged heavy synthetics."
is_playable = true
primary_color = Color(0.2, 0.96, 0.86, 1)
accent_color = Color(0.28, 0.98, 0.62, 1)
starting_hub_scene = ExtResource("2_hub")
worker_scene = ExtResource("3_worker")
harvester_scene = ExtResource("4_harvester")
engineer_scene = ExtResource("5_engineer")
building_roster = Array[Resource("res://scripts/data/building_data.gd")]([ExtResource("6_b_nexus"), ExtResource("7_b_pylon"), ExtResource("8_b_cond"), ExtResource("9_b_main"), ExtResource("10_b_vat"), ExtResource("11_b_fnd"), ExtResource("12_b_fab")])
unit_roster = Array[Resource("res://scripts/data/unit_data.gd")]([ExtResource("13_u_wrk"), ExtResource("14_u_harv"), ExtResource("15_u_eng"), ExtResource("16_u_cln"), ExtResource("17_u_stg"), ExtResource("18_u_sym"), ExtResource("19_u_lnc"), ExtResource("20_u_jam"), ExtResource("21_u_gol"), ExtResource("22_u_arc"), ExtResource("23_u_mrt")])
upgrade_roster = Array[Resource("res://scripts/data/upgrade_data.gd")]([ExtResource("24_upg_be"), ExtResource("25_upg_ap"), ExtResource("26_upg_co")])
ai_build_profile = {
&"barracks_t1": &"cloning_vat",
&"compute_hub": &"wetware_mainframe",
&"counter_foundry": &"calibration_foundry",
&"heavy_t2": &"synthetics_fabricator",
&"hub": &"nexus_vat",
&"refinery": &"silica_condenser",
&"supply": &"synapse_pylon"
}
